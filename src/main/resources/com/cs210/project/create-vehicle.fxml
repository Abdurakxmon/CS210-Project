<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.cs210.project.CreateVehicleController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <Label text="Create New Vehicle" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <GridPane hgap="10" vgap="10">
        <Label text="Location ID (Req):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="locationIdField" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Numbers only"/>
        
        <Label text="Barcode ID (Req):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="barcodeIdField" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Numbers only"/>
        
        <Label text="Type (Req):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="vehicleTypeCombo" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="Select Type..."/>
        
        <Label text="License Num (Req):" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="licenseNumberField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        
        <Label text="Stock Num (Req):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="stockNumberField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        
        <Label text="Status (Req):" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <ComboBox fx:id="statusCombo" GridPane.columnIndex="1" GridPane.rowIndex="5" promptText="Select Status..."/>
        
        <Label text="Make:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <TextField fx:id="makeField" GridPane.columnIndex="1" GridPane.rowIndex="6" promptText="e.g. Toyota"/>
        
        <Label text="Model:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <TextField fx:id="modelField" GridPane.columnIndex="1" GridPane.rowIndex="7" promptText="e.g. Camry"/>
        
        <Label text="Year:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
        <TextField fx:id="yearField" GridPane.columnIndex="1" GridPane.rowIndex="8" promptText="e.g. 2021"/>
    </GridPane>
    
    <Label fx:id="messageLabel" wrapText="true"/>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#onCancelButtonClick"/>
        <Button text="Save Vehicle" onAction="#onSaveButtonClick" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>
