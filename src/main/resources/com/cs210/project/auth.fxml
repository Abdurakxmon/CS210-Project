<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.cs210.project.authentication.AuthController"
           stylesheets="@styles/auth.css"
           styleClass="auth-root">
    <HBox maxWidth="1120" prefHeight="680" styleClass="auth-shell">
        <VBox HBox.hgrow="ALWAYS" prefWidth="620" styleClass="hero-panel">
            <padding>
                <Insets top="42" right="40" bottom="42" left="40" />
            </padding>

            <Label text="CS210 CAR RENTAL" styleClass="hero-kicker" />
            <Label text="Authentication first, everything else after." wrapText="true" styleClass="hero-title" />
            <Label text="This refactor focuses only on sign in and registration with Ebean against your MySQL accounts table."
                   wrapText="true"
                   styleClass="hero-copy" />

            <VBox spacing="16">
                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="feature-row">
                    <Label text="01" styleClass="feature-badge" />
                    <VBox spacing="4">
                        <Label text="Cleaner structure" styleClass="feature-title" />
                        <Label text="Authentication, persistence, and domain code now live in separate packages."
                               wrapText="true"
                               styleClass="feature-copy" />
                    </VBox>
                </HBox>

                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="feature-row">
                    <Label text="02" styleClass="feature-badge" />
                    <VBox spacing="4">
                        <Label text="Secure passwords" styleClass="feature-title" />
                        <Label text="Passwords stay PBKDF2-hashed, matching the format already used in your dump."
                               wrapText="true"
                               styleClass="feature-copy" />
                    </VBox>
                </HBox>

                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="feature-row">
                    <Label text="03" styleClass="feature-badge" />
                    <VBox spacing="4">
                        <Label text="Auth-only scope" styleClass="feature-title" />
                        <Label text="The dashboard is intentionally minimal for now so we keep this slice focused."
                               wrapText="true"
                               styleClass="feature-copy" />
                    </VBox>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Label text="Use the register tab to create a new member account, or sign in with an existing account."
                   wrapText="true"
                   styleClass="hero-footnote" />
        </VBox>

        <VBox prefWidth="430" styleClass="form-panel">
            <padding>
                <Insets top="34" right="32" bottom="34" left="32" />
            </padding>

            <Label text="Account Access" styleClass="panel-kicker" />
            <Label text="Sign in or create your account" wrapText="true" styleClass="panel-title" />
            <Label text="Connected with Ebean and built around the `accounts` table from your car rental schema."
                   wrapText="true"
                   styleClass="panel-copy" />

            <TabPane fx:id="authTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="auth-tabs" VBox.vgrow="ALWAYS">
                <tabs>
                    <Tab fx:id="loginTab" text="Login">
                        <ScrollPane fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED"
                                    styleClass="form-scroll">
                            <content>
                                <VBox spacing="14" styleClass="form-stack">
                                    <padding>
                                        <Insets top="20" right="6" bottom="8" left="6" />
                                    </padding>

                                    <Label text="Email" styleClass="field-label" />
                                    <TextField fx:id="loginEmailField" promptText="you@example.com" styleClass="app-field" />

                                    <Label text="Password" styleClass="field-label" />
                                    <PasswordField fx:id="loginPasswordField" promptText="Enter password" styleClass="app-field" />

                                    <Button text="Login"
                                            defaultButton="true"
                                            maxWidth="1.7976931348623157E308"
                                            onAction="#onLoginClick"
                                            styleClass="primary-button" />

                                    <Label fx:id="loginMessageLabel"
                                           minHeight="40"
                                           wrapText="true"
                                           styleClass="status-label" />
                                </VBox>
                            </content>
                        </ScrollPane>
                    </Tab>

                    <Tab text="Register">
                        <ScrollPane fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED"
                                    styleClass="form-scroll">
                            <content>
                                <VBox spacing="14" styleClass="form-stack">
                                    <padding>
                                        <Insets top="20" right="6" bottom="8" left="6" />
                                    </padding>

                                    <Label text="Full name" styleClass="field-label" />
                                    <TextField fx:id="registerFullNameField" promptText="Your full name" styleClass="app-field" />

                                    <Label text="Email" styleClass="field-label" />
                                    <TextField fx:id="registerEmailField" promptText="you@example.com" styleClass="app-field" />

                                    <Label text="Phone" styleClass="field-label" />
                                    <TextField fx:id="registerPhoneField" promptText="+1 555 123 4567" styleClass="app-field" />

                                    <Label text="Password" styleClass="field-label" />
                                    <PasswordField fx:id="registerPasswordField" promptText="Minimum 6 characters" styleClass="app-field" />

                                    <Label text="Confirm password" styleClass="field-label" />
                                    <PasswordField fx:id="registerConfirmPasswordField" promptText="Repeat your password" styleClass="app-field" />

                                    <Button text="Create account"
                                            maxWidth="1.7976931348623157E308"
                                            onAction="#onRegisterClick"
                                            styleClass="secondary-button" />

                                    <Label fx:id="registerMessageLabel"
                                           minHeight="40"
                                           wrapText="true"
                                           styleClass="status-label" />
                                </VBox>
                            </content>
                        </ScrollPane>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </HBox>
</StackPane>
