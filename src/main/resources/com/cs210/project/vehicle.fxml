<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.cs210.project.VehicleController">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
    <top>
        <Label text="Vehicle Inventory Management" style="-fx-font-size: 20px; -fx-font-weight: bold;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="15"/></padding>
        </Label>
    </top>
    
    <center>
        <!-- Data Table (Master View) -->
        <TableView fx:id="vehicleTable" prefWidth="600" onMouseClicked="#onTableSelection">
            <columns>
                <TableColumn text="ID" prefWidth="50"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
                <TableColumn text="Type" prefWidth="80"><cellValueFactory><PropertyValueFactory property="vehicleType"/></cellValueFactory></TableColumn>
                <TableColumn text="Make" prefWidth="90"><cellValueFactory><PropertyValueFactory property="make"/></cellValueFactory></TableColumn>
                <TableColumn text="Model" prefWidth="90"><cellValueFactory><PropertyValueFactory property="model"/></cellValueFactory></TableColumn>
                <TableColumn text="License Plate" prefWidth="110"><cellValueFactory><PropertyValueFactory property="licenseNumber"/></cellValueFactory></TableColumn>
                <TableColumn text="Status" prefWidth="90"><cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory></TableColumn>
                <TableColumn text="Loc ID" prefWidth="60"><cellValueFactory><PropertyValueFactory property="locationId"/></cellValueFactory></TableColumn>
            </columns>
        </TableView>
    </center>
    
    <right>
        <!-- Editor Form (Detail View) -->
        <VBox spacing="10" prefWidth="320" style="-fx-border-color: #d3d3d3; -fx-border-width: 0 0 0 1; -fx-padding: 0 0 0 15;">
            <Label text="Vehicle Editor" style="-fx-font-size: 16px; -fx-font-weight: bold;">
                <padding><Insets bottom="5"/></padding>
            </Label>
            
            <GridPane hgap="10" vgap="10">
                <Label text="Location ID *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="locationIdField" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Numbers only"/>
                
                <Label text="Barcode ID *" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="barcodeIdField" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Numbers only"/>
                
                <Label text="Type *" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="vehicleTypeCombo" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="160" promptText="Select Type..."/>
                
                <Label text="License Num *" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="licenseNumberField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                
                <Label text="Stock Num *" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="stockNumberField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                
                <Label text="Status *" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <ComboBox fx:id="statusCombo" GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="160" promptText="Select Status..."/>
                
                <Label text="Make" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <TextField fx:id="makeField" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                
                <Label text="Model" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <TextField fx:id="modelField" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                
                <Label text="Year" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                <TextField fx:id="yearField" GridPane.columnIndex="1" GridPane.rowIndex="8" promptText="e.g. 2021"/>
            </GridPane>
            
            <Label fx:id="messageLabel" wrapText="true" minHeight="40" style="-fx-text-fill: #555;"/>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Clear Selection" onAction="#onClearClick"/>
                <Button fx:id="deleteButton" text="Delete" onAction="#onDeleteClick" disable="true" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Save / Update" onAction="#onSaveClick" style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
